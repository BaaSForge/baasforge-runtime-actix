# ! ====== important Note: Do not use "" or '' (any quotes) in this file!! ======
PORT=1501
APP_ENV=staging

DATABASE_URL=postgres://baal:PASSWORD_HERE@localhost:5632/baal_db?sslmode=disable
DATABASE_POOL_SIZE=3
DATABASE_CONNECTION_TIMEOUT_SECS=30
DATABASE_POOL_IDLE_TIMEOUT_SECS=600
API_WORKER_MAX_BLOCKING_THREADS=512

REDIS_URL=redis://localhost:6379
REDIS_CACHE_ENABLED=true

NATS_URL=nats://runtime_nats:PASSWORD_HERE@localhost:4222
NATS_SUBJECT_RELEASE=runtime.release
NATS_JETSTREAM_STREAM_RELEASE=RUNTIME_RELEASE
NATS_JETSTREAM_CONSUMER_RELEASE=release_deploy

NATS_SUBJECT_RUNTIME_ENV=runtime.env
NATS_JETSTREAM_STREAM_RUNTIME_ENV=RUNTIME_ENV
NATS_JETSTREAM_CONSUMER_RUNTIME_ENV=runtime_env_invalidate

WF_REDIS_URL=redis://localhost:6379
WF_NATS_URL=nats://runtime_nats:PASSWORD_HERE@localhost:4222
WF_NATS_JETSTREAM_STREAM=WF_WAKE
WF_NATS_JETSTREAM_CONSUMER=wf_wake_consumer

WQ_REDIS_URL=redis://localhost:6379
WQ_NATS_URL=nats://runtime_nats:PASSWORD_HERE@localhost:4222

ACTOR_DATABASE_URL=postgres://baal:PASSWORD_HERE@localhost:5632/baal_actor_db?sslmode=disable
ACTOR_DATABASE_POOL_SIZE=3
ACTOR_DATABASE_CONNECTION_TIMEOUT_SECS=30
ACTOR_DATABASE_POOL_IDLE_TIMEOUT_SECS=600
ACTOR_REDIS_URL=redis://localhost:6379
ACTOR_NATS_URL=nats://runtime_nats:PASSWORD_HERE@localhost:4222
ACTOR_NATS_JETSTREAM_STREAM=ACTOR_MAIL
ACTOR_NATS_JETSTREAM_CONSUMER=actor_mail_consumer
ACTOR_LEASE_TTL_SECS=30
ACTOR_IDLE_SWEEP_SECS=60
ACTOR_PG_FLUSH_INTERVAL_SECS=30

# -- Usage metering (compute_gb_ms memory assumptions) --
USAGE_METER_MEMORY_MB_API=256
USAGE_METER_MEMORY_MB_ACTOR=256
USAGE_METER_MEMORY_MB_QUEUE_WORKER=256
USAGE_METER_MEMORY_MB_WORKFLOW=512

# -- Usage batch ingest (NATS JetStream → project_usage_entries) --
USAGE_INGEST_ENABLED=true
USAGE_PUBLISH_BATCH_SIZE=100
USAGE_PUBLISH_FLUSH_MS=2000
USAGE_PUBLISH_CHANNEL_CAPACITY=4096
NATS_JETSTREAM_STREAM_USAGE=USAGE_EVENTS
NATS_SUBJECT_USAGE_BATCH=usage.events.batch
NATS_JETSTREAM_CONSUMER_USAGE=usage_ingest_consumer
USAGE_DB_BATCH_SIZE=1000
USAGE_DB_MAX_FLUSH_MS=300000

OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
